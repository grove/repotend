{
  "name": "repotend",
  "version": "0.1.0-dev",
  "private": true,
  "type": "module",
  "description": "Advisory repository health checks for small open-source projects",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test",
    "audit": "node skills/repotend/scripts/audit.mjs --format markdown",
    "audit:json": "node skills/repotend/scripts/audit.mjs --format json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate:external": "node scripts/validate-external.mjs",
    "remediate": "node skills/repotend/scripts/remediate.mjs",
    "format": "node scripts/check-style.mjs --write",
    "format:check": "node scripts/check-style.mjs",
    "lint": "node scripts/lint.mjs && npm run typecheck"
  },
  "dependencies": {
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "typescript": "5.9.3"
  }
}
