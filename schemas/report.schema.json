{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/grove/repotend/v0.1.0/schemas/report.schema.json",
  "title": "RepoTend audit report v0.1",
  "description": "Read-only audit findings. Remediation preview/apply results use separate contracts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "toolVersion",
    "repository",
    "mode",
    "profile",
    "findings",
    "errors"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1"
    },
    "toolVersion": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "const": "."
        }
      }
    },
    "mode": {
      "const": "audit"
    },
    "profile": {
      "const": "small-oss"
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/error"
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "suppression": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "active"
      ],
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "expires": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "active": {
          "type": "boolean"
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ruleId",
        "ruleVersion",
        "status",
        "severity",
        "confidence",
        "summary",
        "evidence",
        "recommendation",
        "enforced"
      ],
      "properties": {
        "ruleId": {
          "type": "string",
          "minLength": 1
        },
        "ruleVersion": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "PASS",
            "WARN",
            "FAIL",
            "UNKNOWN",
            "NOT_APPLICABLE",
            "SUPPRESSED"
          ]
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "confidence": {
          "enum": [
            "verified",
            "heuristic"
          ]
        },
        "summary": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "recommendation": {
          "type": [
            "string",
            "null"
          ]
        },
        "enforced": {
          "type": "boolean"
        },
        "suppression": {
          "$ref": "#/$defs/suppression"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "SUPPRESSED"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "suppression"
            ],
            "properties": {
              "suppression": {
                "properties": {
                  "active": {
                    "const": true
                  }
                }
              }
            }
          }
        }
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "ruleId": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string"
        }
      }
    }
  }
}
